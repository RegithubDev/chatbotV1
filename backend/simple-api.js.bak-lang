const http = require("http");
const fs = require("fs");
const path = require("path");
require("dotenv").config({ path: path.join(__dirname, ".env") });
require("dotenv").config({ path: path.join(__dirname, "..", ".env") });
const mysql = require("mysql2/promise");

const PORT = Number(process.env.PORT || 3020);
const OLLAMA = process.env.OLLAMA_URL || "http://127.0.0.1:11434";
const SQL_MODEL = process.env.SQL_MODEL || "qwen2.5-coder:7b-instruct";
const CATALOG = path.join(__dirname, "..", "data", "catalog", "schema.json");
const sessions = new Map();
const SESSFILE = require("path").join(__dirname, "..", "data", "sessions.json");
function loadSessions() {
  try {
    const raw = JSON.parse(require("fs").readFileSync(SESSFILE, "utf8"));
    for (const [k, v] of Object.entries(raw)) sessions.set(k, v);
  } catch {}
}
function saveSessions() {
  try {
    require("fs").mkdirSync(require("path").dirname(SESSFILE), { recursive: true });
    require("fs").writeFileSync(SESSFILE, JSON.stringify(Object.fromEntries(sessions), null, 0));
  } catch {}
}
loadSessions();
const STOP = new Set("a an the this that these those is are was were be been being and or not of to in for on from by with as at it its if so do did does how many much what which who where when why please table tables database data row rows record records all some any get fetch select count number named name names give tell about type types of there here show list me my our your connected exist exists based".split(" "));

function rawSend(res, code, body) {
  res.writeHead(code, { "Content-Type": "application/json", "Access-Control-Allow-Origin": "*" });
  res.end(JSON.stringify(body));
}
function remember(mem, q, a) {
  if (!mem) return;
  mem.messages = mem.messages || [];
  if (q) mem.messages.push({ role: "user", content: q });
  if (a) mem.messages.push({ role: "assistant", content: String(a).slice(0, 800) });
  mem.messages = mem.messages.slice(-20);
  try { saveSessions(); } catch {}
}
function send(res, code, body) {
  try {
    const qn = global.__lastQ || "";
    if (body && typeof body.answer === "string") {
      body.answer = body.answer.replace(/\n+You can also ask:[\s\S]*$/i, "").trim();
    }
    if (body && Array.isArray(body.suggestions)) {
      body.suggestions = body.suggestions.filter((s) => !/^show /i.test(String(s)));
    }
    if (body && Array.isArray(body.data)) body.data = slimData(qn, body.data);
  } catch (e) { console.log("slim", e.message); }
  try {
    const qn = global.__lastQ || "";
    if (body && typeof body.answer === "string") {
      body.answer = body.answer.replace(/\n+You can also ask:[\s\S]*$/i, "").trim();
    }
    if (body && Array.isArray(body.suggestions)) {
      body.suggestions = body.suggestions.filter((s) => !/^show /i.test(String(s)));
    }
    if (body && Array.isArray(body.data)) body.data = slimData(qn, body.data);
  } catch (e) { console.log("slim", e.message); }
  if (body && typeof body === "object" && body.answer != null && String(body.answer).trim() === "") body.answer = null;
  if (body && typeof body === "object" && (body.answer == null) && code === 200) {
    body.answer = "I could not build an answer from the connected database for that. Try a name that exists in your data.";
  }
  if (body && typeof body === "object") {
    if (body.answer) body.answer = cleanAnswer(body.answer);
    if (body.suggestions) body.suggestions = cleanSuggest(body.suggestions);
    if (Array.isArray(body.data)) {
      body.data = body.data.map((row) => {
        if (!row || typeof row !== "object") return row;
        const out = {};
        for (const k of Object.keys(row)) {
          const key = k === "_table" || k === "table" ? "type" : k;
          let v = row[k];
          if (key === "type" || key === "table") v = humanTable(v);
          out[key] = v;
        }
        return out;
      });
    }
  }
    try {
    if (body && body.answer && typeof sess === "function") {
      /* chatId is not here — remember in /ask instead */
    }
  } catch {}
  rawSend(res, code, body);
}
function pool() {
  return mysql.createPool({
    host: process.env.DB_HOST || "localhost",
    port: Number(process.env.DB_PORT || 3306),
    user: process.env.DB_USER,
    password: process.env.DB_PASSWORD,
    database: process.env.DB_NAME,
    connectionLimit: 8,
  });
}
function loadCatalog() {
  if (!fs.existsSync(CATALOG)) return null;
  return JSON.parse(fs.readFileSync(CATALOG, "utf8"));
}
function sess(id) {
  const k = id || "default";
  if (!sessions.has(k)) sessions.set(k, { lastTables: [], lastData: [] });
  return sessions.get(k);
}
function readBody(req) {
  return new Promise((resolve) => {
    let d = "";
    req.on("data", (c) => (d += c));
    req.on("end", () => { try { resolve(d ? JSON.parse(d) : {}); } catch { resolve({}); } });
  });
}
function todayStamp() {
  return new Date().toLocaleString("en-US", { weekday: "long", month: "short", day: "numeric", year: "numeric" });
}
async function think(messages, n) {
  const groqKey = process.env.GROQ_API_KEY;
  const chain = [
    process.env.GROQ_MODEL || "qwen/qwen3.8-27b",
    "qwen/qwen3.8-27b",
    "qwen/qwen3.6-27b",
    "openai/gpt-oss-120b",
    "openai/gpt-oss-20b",
    "groq/compound",
    "groq/compound-mini",
    "llama-3.1-8b-instant"
  ].filter((v, i, a) => v && a.indexOf(v) === i);

  if (groqKey) {
    for (const groqModel of chain) {
      try {
        const r = await fetch("https://api.groq.com/openai/v1/chat/completions", {
          method: "POST",
          headers: { Authorization: "Bearer " + groqKey, "Content-Type": "application/json" },
          body: JSON.stringify({ model: groqModel, messages: [{ role: 'system', content: 'Today is ' + todayStamp() + '. Use dates like Aug 16, 2026. Answer the user question. Do not say you are restricted to C and D only.' }].concat(messages), temperature: 0.4, max_tokens: n || 220 })
        });
        if (r.ok) {
          const data = await r.json();
          const text = data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content;
          if (text) { console.log("LLM=groq", groqModel); return text; }
        }
        const err = (await r.text()).slice(0, 180);
        console.log("Groq skip", groqModel, r.status, err);
        if (r.status === 429) { console.log("rate-limit", groqModel || model); break; } if (r.status === 401 || r.status === 403) break;
      } catch (e) {
        console.log("Groq skip", groqModel, e.message);
      }
    }
  }

  throw new Error('Free chat requests completed.');
  const local = process.env.CHAT_MODEL || process.env.SQL_MODEL || "qwen2.5-coder:7b-instruct";
  const r2 = await fetch((process.env.OLLAMA_URL || "http://127.0.0.1:11434") + "/api/chat", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model: local,
      messages,
      stream: false,
      keep_alive: "30m",
      options: { temperature: 0.4, num_predict: n || 280 }
    })
  });
  if (!r2.ok) throw new Error("local " + r2.status + " " + (await r2.text()));
  console.log("LLM=local", local);
  return ((await r2.json()).message || {}).content || "";
}
function cols(t) { return (t.columns || []).map((c) => (typeof c === "string" ? c : c.name)); }
function tokens(q) { return q.toLowerCase().split(/[^a-z0-9_]+/).filter((w) => w.length > 2 && !STOP.has(w)); }
function scoreTable(t, tks) {
  const name = t.name.toLowerCase();
  const parts = name.split("_");
  const cns = cols(t).map((n) => n.toLowerCase());
  let score = 0;
  for (const tok of tks) {
    if (name === tok) score += 100;
    else if (name.startsWith(tok) || name.endsWith(tok)) score += 55;
    else if (name.includes(tok)) score += 36;
    if (parts.includes(tok)) score += 40;
    for (const c of cns) { if (c === tok) score += 18; else if (c.includes(tok)) score += 8; }
  }
  return score;
}
function matchAll(catalog, q) {
  const tks = tokens(q);
  return catalog.tables.map((t) => ({ t, name: t.name, columns: cols(t), score: scoreTable(t, tks) })).filter((x) => x.score > 0).sort((a, b) => b.score - a.score);
}
function dateCol(names) {
  return names.find((n) => /order_date|created_at|updated_at|schedule_date|created_on/i.test(n)) || names.find((n) => /date|time|created|updated/i.test(n));
}
function pickCols(names) {
  const prefer = names.filter((n) => /code|status|type|name|size|price|amount|date|customer|platform|comment/i.test(n));
  return (prefer.length ? prefer : names).slice(0, 10);
}
function greet(q) {
  const s = q.toLowerCase().trim();
  if (/^(hi|hello|hey|yo|hai|namaste|vanakkam)[\s!.,]*$/.test(s)) return "Hi. I am Recollect AI Bot. Ask about your connected database in normal language. I remember this chat until you start a new one.";
  if (/how are you/.test(s)) return "Doing well — ready when you are.";
  if (/who are you|what can you do/.test(s)) return "I search every matching table, read real rows, and explain them in plain language. I will not invent numbers.";
  if (/thank/.test(s)) return "You're welcome.";
  return null;
}
async function speak(question, facts, tableNames, suggestions) {
  const names = tableNames || [];
  const sug = suggestions || [];
  let spoken = "";
  try {
    spoken = (await think([
      { role: "system", content: "You are Recollect AI Bot. Warm, clear, short paragraphs. Use ONLY the facts. Never invent prices or extra rows. Never mention table names, column names, schema, SQL, or the word backend. Never list columns. Answer with the actual records only. Use everyday words like Waste orders, scrap orders, bag prices. Do not list database objects. Speak in short friendly sentences. You may use a light emoji." },
      { role: "user", content: "Q: " + question + "\nMatching tables: " + names.join(", ") + "\nFacts:\n" + facts + "\nSuggestions: " + sug.join(" | ") }
    ], 280)).trim();
  } catch {}
  const bad = !spoken || /select\s+/i.test(spoken) || (/\$\d/.test(spoken) && String(facts).indexOf("$") < 0);
  if (bad) {
    spoken = facts;
    if (names.length) spoken += "\n\nMatching tables for that keyword:\n" + names.map((n, i) => (i + 1) + ". " + n).join("\n");
  }
  if (sug.length && !/you can also ask/i.test(spoken)) { /* chips only, do not append to answer */ }
  return spoken;
}


function prettyName(n) {
  return String(n)
    .replace(/^backend_/, "")
    .replace(/^auth_/, "")
    .replace(/_/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}
function orderKind(name) {
  const n = String(name).toLowerCase();
  if (/biowaste/.test(n)) return "Biowaste";
  if (/\bbwg\b/.test(n)) return "BWG";
  if (/scrap/.test(n)) return "Scrap";
  if (/complete/.test(n)) return "Completed";
  if (/dropped/.test(n)) return "Dropped";
  if (/previousday|previous_day/.test(n)) return "Previous day";
  return String(name).replace(/^backend_/, "").replace(/_/g, " ");
}
function humanSuggest(kind) {
  return "Latest " + String(kind).toLowerCase() + " order";
}
function humanTable(n) {
  return String(n || "")
    .replace(/^backend_/, "")
    .replace(/^auth_/, "")
    .replace(/^django_/, "")
    .replace(/_/g, " ")
    .replace(/\bcompleteorders\b/i, "completed orders")
    .replace(/\bbiowasteorders\b/i, "biowaste orders")
    .replace(/\bbwgorders\b/i, "BWG orders")
    .replace(/\bscraporders\b/i, "scrap orders")
    .replace(/\bpreviousdayorders\b/i, "previous day orders")
    .replace(/\bdroppedorder\b/i, "dropped orders")
    .replace(/\s+/g, " ")
    .trim();
}
function cleanSuggest(list) {
  return (list || []).map((s) => {
    let x = String(s).replace(/Latest row in\s+/i, "Latest ");
    x = x.replace(/backend_[a-z0-9_]+/gi, (m) => humanTable(m));
    return x.charAt(0).toUpperCase() + x.slice(1);
  }).filter((s) => s && !/^backend_/i.test(s));
}
function cleanAnswer(text) {
  return String(text || "").replace(/backend_[a-z0-9_]+/gi, (m) => humanTable(m));
}
function entityTokens(q) {
  const stop = new Set("a an the this that how many much number count of do we have i my your our is are there here please show give tell about active inactive total".split(" "));
  return q.toLowerCase().split(/[^a-z0-9_]+/).filter((w) => w.length > 2 && !stop.has(w));
}
function matchEntityTables(catalog, q) {
  const toks = entityTokens(q);
  if (!toks.length || !catalog || !catalog.tables) return [];
  return catalog.tables.map((tb) => {
    const name = String(tb.name || "").toLowerCase();
    const pretty = String(tb.pretty || tb.name || "").toLowerCase();
    let score = 0;
    for (const tok of toks) {
      const stem = tok.endsWith("s") ? tok.slice(0, -1) : tok;
      if (name === tok || name === stem) score += 80;
      if (name.endsWith("_" + tok) || name.endsWith("_" + stem)) score += 50;
      if (name.includes(tok) || name.includes(stem)) score += 20;
      if (pretty.includes(tok) || pretty.includes(stem)) score += 15;
    }
    return { tb, name: tb.name, pretty: tb.pretty || tb.name, score, inbound: tb.inbound || 0, pk: tb.pk || [] };
  }).filter((x) => x.score > 0).sort((a, b) => b.score - a.score || b.inbound - a.inbound);
}
function isFollowUp(q) {
  return /(more\s+de|tell me more|explain|those|that list|same|previous|what about|continue|and\b)/i.test(String(q));
}
let suggestionCache = { at: 0, items: [] };
async function generateSuggestions(cat) {
  if (!cat || !cat.tables || !cat.tables.length) return ["How many tables are connected?"];
  if (Date.now() - suggestionCache.at < 10 * 60 * 1000 && suggestionCache.items.length) return suggestionCache.items;
  const index = cat.tables.map((t) => {
    const cols = (t.columns || []).map((c) => (typeof c === "string" ? c : c.name)).slice(0, 6);
    const label = String(t.name || "").replace(/^backend_|^auth_|^cnd_|^django_/, "").replace(/_/g, " ");
    return label + (cols.length ? " [" + cols.join(", ") + "]" : "");
  }).slice(0, 80).join("\n");
  let items = [];
  try {
    const raw = await think([
      { role: "system", content: "Write 5 short questions a business user would ask this database. Everyday English. No SQL. No raw table names. No the word backend. One question per line. No numbering." },
      { role: "user", content: "Database lists:\n" + index }
    ], 180);
    items = String(raw || "").split(/\r?\n/).map((s) => s.replace(/^\d+[\).:-]\s*/, "").replace(/^[-*]\s*/, "").trim()).filter((s) => s.length > 8 && s.length < 80).slice(0, 6);
  } catch (e) { console.log("suggest", e.message); }
  if (!items.length) {
    items = cat.tables.slice(0, 5).map((t) => "Tell me about " + String(t.name || "").replace(/^backend_|^auth_/, "").replace(/_/g, " "));
  }
  suggestionCache = { at: Date.now(), items };
  return items;
}
function liveSuggestions(cat) {
  if (suggestionCache.items.length) return suggestionCache.items;
  if (!cat || !cat.tables) return ["How many tables are connected?"];
  return cat.tables.slice(0, 5).map((t) => "Tell me about " + String(t.name || "").replace(/^backend_|^auth_/, "").replace(/_/g, " "));
}
function rowsForQuestion(q, rows) {
  if (!Array.isArray(rows) || !rows.length) return rows;
  const m = String(q).match(/\b(?:circle\s*)?c?\s*(\d{1,3})\b/i);
  if (m) {
    const n = m[1];
    const hit = rows.filter((r) => {
      const blob = Object.values(r).map((v) => String(v || "")).join(" ");
      return new RegExp("(?:^|\\b)(?:C)?" + n + "\\b|Circle\\s*" + n + "\\b", "i").test(blob);
    });
    if (hit.length) return hit;
  }
  const extra = String(q).toLowerCase().replace(/tell me about|about this|details|please/g, " ");
  const words = extra.split(/[^a-z0-9]+/).filter((w) => w.length > 3 && !/circle|tell|about|this/.test(w));
  if (words.length) {
    const hit = rows.filter((r) => {
      const blob = Object.values(r).join(" ").toLowerCase();
      return words.some((w) => blob.includes(w));
    });
    if (hit.length) return hit;
  }
  return rows;
}
function fmtVal(v) {
  if (v == null || v === "") return v;
  const d = v instanceof Date ? v : (typeof v === "string" && /^\d{4}-\d{2}-\d{2}/.test(v) ? new Date(v) : null);
  if (d && !isNaN(d.getTime())) {
    return d.toLocaleString("en-US", { month: "short", day: "numeric", year: "numeric" });
  }
  return v;
}
function slimData(q, rows) {
  if (!Array.isArray(rows)) return rows;
  let out = rows;
  const m = String(q || "").match(/circle\s*(\d{1,3})|\bC(\d{1,3})\b/i);
  if (m) {
    const n = m[1] || m[2];
    const hit = rows.filter((r) => String((r && (r.code || r.name)) || "").match(new RegExp("C?" + n + "\\b|Circle\\s*" + n + "\\b", "i")));
    if (hit.length) out = hit;
  }
  return out.map((r) => {
    if (!r || typeof r !== "object") return r;
    const o = {};
    for (const [k, v] of Object.entries(r)) o[k] = fmtVal(v);
    return o;
  });
}
const server = http.createServer(async (req, res) => {
  if (req.method === "OPTIONS") {
    res.writeHead(204, { "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "GET,POST,OPTIONS", "Access-Control-Allow-Headers": "Content-Type" });
    return res.end();
  }
  try {
        if (req.method === "GET" && String(req.url || "").split("?")[0] === "/schema/suggestions") {
      const c = loadCatalog();
      let suggestions = ["How many tables are connected?"];
      try {
        if (typeof generateSuggestions === "function") suggestions = await generateSuggestions(c);
        else if (typeof liveSuggestions === "function") suggestions = liveSuggestions(c);
      } catch (e) { console.log("suggestions", e.message); }
      return send(res, 200, { answer: "ok", suggestions: suggestions || [], tables: c ? c.tables.length : 0 });
    }
    if (req.method === "GET" && (req.url === "/" || req.url === "/health")) return send(res, 200, { ok: true, db: process.env.DB_NAME, tables: (loadCatalog() && loadCatalog().tables.length) || 0, knowledge: require("fs").existsSync(require("path").join(__dirname, "..", "data", "knowledge", "db-brief.md")), refreshedAt: loadCatalog() && loadCatalog().refreshedAt });
    if (req.method === "POST" && req.url === "/session/reset") {
      const b = await readBody(req);
      if (b.chatId) sessions.delete(b.chatId);
      return send(res, 200, { ok: true });
    }
    if (req.method === "POST" && req.url === "/schema/refresh") {
      const db = await pool();
      try {
        const [dbn] = await db.query("SELECT DATABASE() AS name");
        const [tables] = await db.query("SELECT table_name AS name, IFNULL(table_comment,'') AS tableComment FROM information_schema.tables WHERE table_schema = DATABASE() AND table_type='BASE TABLE'");
        const [c] = await db.query("SELECT table_name AS tableName, column_name AS name, data_type AS dataType FROM information_schema.columns WHERE table_schema = DATABASE()");
        const [rels] = await db.query("SELECT table_name AS fromTable, column_name AS fromColumn, referenced_table_name AS toTable, referenced_column_name AS toColumn FROM information_schema.key_column_usage WHERE table_schema = DATABASE() AND referenced_table_name IS NOT NULL");
        const by = {};
        for (const x of c) { by[x.tableName] = by[x.tableName] || []; by[x.tableName].push({ name: x.name, type: x.dataType }); }
        const catalog = { database: dbn[0] && dbn[0].name, refreshedAt: new Date().toISOString(), tables: tables.map((t) => ({ name: t.name, comment: t.tableComment, columns: by[t.name] || [] })), relationships: rels };
        fs.mkdirSync(path.dirname(CATALOG), { recursive: true });
        fs.writeFileSync(CATALOG, JSON.stringify(catalog, null, 2));
        return send(res, 200, { database: catalog.database, tables: catalog.tables.length, relationships: catalog.relationships.length });
      } finally { await db.end(); }
    }
    if (req.method === "POST" && req.url === "/ask") {
      const body = await readBody(req);
            let q = String(body.question || "").trim(); global.__lastQ = q;
      const _mem = sess(body.chatId);
      if (_mem && isFollowUp(q) && _mem.lastQ) {
        q = _mem.lastQ + ". " + q;
      }
      try {
        const mem0 = sess(body && body.chatId);
        if (mem0 && isFollowUp(q) && (mem0.lastTable || mem0.lastQ)) {
          const dbc = await pool();
          let rows = [];
          try {
            const [cols] = await dbc.query("SELECT column_name AS n FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name = ?", [mem0.lastTable]);
            const names = cols.map((c) => c.n).filter((n) => !/^password|plain_password|token/i.test(n)).slice(0, 12);
            const sql = "SELECT " + names.map((n) => "`" + n + "`").join(",") + " FROM `" + mem0.lastTable + "` LIMIT 20";
            rows = (await dbc.query(sql))[0];
          } finally { await dbc.end(); }
          const facts = rows.map((r, i) => (i + 1) + ". " + Object.entries(r).filter(([, v]) => v != null && v !== "").map(([k, v]) => k.replace(/_/g, " ") + ": " + v).join("; ")).join("\n");
                    const cleanRows = rows.map((r) => {
            const o = {};
            for (const [k, v] of Object.entries(r)) {
              if (v == null || v === "") continue;
              if (Buffer.isBuffer(v)) continue;
              if (typeof v === "object" && !(v instanceof Date)) continue;
              if (/password|token|icon/i.test(k)) continue;
              o[k] = v instanceof Date ? v.toISOString().slice(0, 10) : v;
            }
            return o;
          });
          const facts2 = cleanRows.map((r, i) => (i + 1) + ". " + Object.entries(r).map(([k, v]) => k.replace(/_/g, " ") + ": " + v).join(", ")).join("\n");
          let answer = facts2;
          try {
            const spoken = await think([
              { role: "system", content: "You are Recollect AI Bot. 5-8 short sentences. Use only these rows. Skip test/dummy rows if obvious. No table names, no SQL, no JSON. Mention types, capacity and price that matter." },
              { role: "user", content: "User wanted more detail after: " + (mem0.lastQ || "") + "\nRows:\n" + facts2 }
            ], 220);
            if (spoken && spoken.trim()) answer = spoken.trim();
          } catch {}
          return send(res, 200, {
            answer,
            sql: null,
            data: rowsForQuestion(q, typeof cleanRows !== "undefined" ? cleanRows : rows),
            suggestions: liveSuggestions(q),
            steps: [{ label: "Used this chat: " + (mem0.lastQ || "") }, { label: "Read more columns from the same list" }]
          });
        }
      } catch (e) { console.log("followup", e.message); }

      if (/how many|number of|count of|how much/i.test(q)) {
        const cat0 = (typeof loadCatalog === "function") ? loadCatalog() : null;
        const hits = matchEntityTables(cat0, q);
        if (hits.length) {
          const master = hits[0]; try { const memS = sess(body.chatId); memS.lastQ = q; memS.lastTable = master.name; memS.lastLabel = entityTokens(q).join(" "); memS.messages = (memS.messages || []).concat([{role:"user",content:q}]).slice(-20); } catch(e) {}
          const dbc = await pool();
          let n = 0, used = master.name;
          try {
            const [cols] = await dbc.query("SELECT column_name AS n FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name = ?", [master.name]);
            const set = new Set(cols.map((c) => String(c.n).toLowerCase()));
            let sql = "SELECT COUNT(*) AS c FROM `" + master.name + "`";
            if (/active/.test(q) && set.has("is_active")) sql += " WHERE is_active = 1";
            const [r] = await dbc.query(sql);
            n = Number(r[0].c || 0);
          } finally { await dbc.end(); }
          const label = entityTokens(q).join(" ") || "records";
          return send(res, 200, {
            answer: "You have **" + n.toLocaleString() + "** " + label + ".",
            _memFix: true,
            sql: null,
            data: [{ count: n }],
            suggestions: liveSuggestions(q),
            steps: [{ label: "Matched your words to the live schema" }, { label: "Counted the best matching list" }],
            remembered: master.name
          });
        }
      }

      const mem = sess(body.chatId);
      const steps = [{ label: "Read the message" }];
      
      const codeHit = q.match(/\b[A-Z]{1,4}\d{1,4}\b/i);
      const place = q.replace(/\bcircle\b/ig, " ").replace(/\b[A-Z]{1,4}\d{1,4}\b/ig, " ").replace(/[^a-z0-9 ]/ig, " ").trim();
      if (codeHit || (place && place.split(/\s+/).join(" ").length >= 4 && /tell me about|about this|what is|details|circle/i.test(q))) {
        const c0 = loadCatalog();
        if (c0) {
          const dbc = await pool();
          let found = [];
          try {
            for (const tb of c0.tables) {
              const cols = (tb.columns || []).map((x) => (typeof x === "string" ? x : x.name));
              const textCols = cols.filter((n) => /code|name|title|label|area|circle|ward/i.test(n));
              if (!textCols.length) continue;
              const where = [];
              if (codeHit) {
                for (const col of textCols) where.push("`" + col + "` LIKE '%" + String(codeHit[0]).replace(/'/g, "") + "%'");
              }
              if (place) {
                const bit = place.split(/\s+/).filter((w) => w.length > 3).slice(0, 3);
                for (const w of bit) for (const col of textCols) where.push("`" + col + "` LIKE '%" + w.replace(/'/g, "") + "%'");
              }
              if (!where.length) continue;
              const show = cols.filter((n) => !/password|token/i.test(n)).slice(0, 10).map((n) => "`" + n + "`").join(",");
              try {
                const [rows] = await dbc.query("SELECT " + show + " FROM `" + tb.name + "` WHERE " + where.join(" OR ") + " LIMIT 8");
                if (rows && rows.length) { found = rows; break; }
              } catch {}
            }
          } finally { await dbc.end(); }
          if (found.length) {
            const facts = found.map((r) => Object.entries(r).filter(([, v]) => v != null && v !== "").map(([k, v]) => k.replace(/_/g, " ") + ": " + v).join(", ")).join("\n");
            let answer = facts;
            try {
              const spoken = await think([
                { role: "system", content: "Answer only about the matching record(s). Do not list the whole catalog. No table names, no column lists, no Show circles." },
                { role: "user", content: q + "\n" + facts }
              ], 180);
              if (spoken) answer = spoken.trim();
            } catch {}
            return send(res, 200, { answer, data: found, suggestions: liveSuggestions(q) });
          }
        }
      }

      const hello = greet(q);
      mem.lastQ = q;
      mem.messages = mem.messages || [];
       if (hello) return send(res, 200, { answer: hello, sql: null, data: [], steps: [{ label: "Greeting" }], suggestions: liveSuggestions(q) });

      const cat = loadCatalog();
      if (!cat) return send(res, 400, { error: "refresh schema first" });
      if (/how many tables|number of tables|tables do we have|tables we have|table count/i.test(q) && !/named|called|like order/i.test(q)) {
        const c0 = loadCatalog();
        const n = c0 ? c0.tables.length : 0;
        const answer = n
          ? ("You currently have **" + n + "** tables in the connected database. 📊")
          : "Schema is not synced yet. Click Sync schema first.";
        return send(res, 200, {
          answer: answer + "\n\nYou can also ask:\n- How many customers do I have?\n- How many orders are there?",
          sql: null, data: n ? [{ tables: n }] : [],
          suggestions: ["How many customers do I have?", "How many orders are there?"],
          steps: [{ label: "Read table count from synced schema" }]
        });
      }

      if (/how many customers|number of customers|customer count|customers do i have|customers we have/i.test(q)) {
        const c0 = loadCatalog();
        if (!c0) return send(res, 400, { error: "Schema not synced" });
        const prefer = c0.tables.filter((tb) => /^(backend_)?(customer|customers|user|users)$/i.test(tb.name));
        const extra = c0.tables.filter((tb) => /customer/i.test(tb.name) && !/log|money|transaction|perday|address|token|otp|device/i.test(tb.name));
        const seen = new Set();
        const list = [...prefer, ...extra].filter((tb) => { if (seen.has(tb.name)) return false; seen.add(tb.name); return true; });
        const dbc = await pool();
        const bits = [];
        try {
          for (const tb of list.slice(0, 8)) {
            try {
              const [r] = await dbc.query("SELECT COUNT(*) AS c FROM `" + tb.name + "`");
              bits.push({ label: prettyName(tb.name), count: Number(r[0].c || 0) });
            } catch {}
          }
        } finally { await dbc.end(); }
        const main = bits[0];
        let answer;
        if (!main) answer = "I could not find a customer list in the synced schema yet.";
        else if (bits.length === 1) answer = "You have **" + main.count.toLocaleString() + "** customers. 🙂";
        else answer = "You have **" + main.count.toLocaleString() + "** customers in the main list. Other related counts: " + bits.slice(1).map((b) => b.count.toLocaleString() + " in " + b.label).join(", ") + ".";
        return send(res, 200, {
          answer: answer + "\n\nYou can also ask:\n- How many orders are there?\n- What is the latest order?",
          sql: null, data: bits, suggestions: liveSuggestions(q),
          steps: [{ label: "Counted customer rows from the live database" }]
        });
      }


      if (/how many orders|number of orders|total orders|count of orders/i.test(q)) {
        const orderTables = cat.tables.filter((tb) => /order/i.test(tb.name) && !/cart|log|usedbag|analytics|permission/i.test(tb.name));
        const dbc = await pool();
        const bits = [];
        try {
          for (const tb of orderTables.slice(0, 12)) {
            try {
              const [c] = await dbc.query("SELECT COUNT(*) AS c FROM `" + tb.name + "`");
              bits.push({ label: prettyName(tb.name), count: Number(c[0].c || 0) });
            } catch {}
          }
        } finally { await dbc.end(); }
        const total = bits.reduce((s, b) => s + b.count, 0);
        const facts = bits.map((b) => b.label + ": " + b.count).join("\n") + "\nall together: " + total;
        const spoken = await think([
          { role: "system", content: "Friendly assistant. Answer how many orders exist using ONLY these counts. Everyday English. No table names, no SQL, no JSON, no word backend. Light emoji ok." },
          { role: "user", content: "Question: " + q + "\nCounts:\n" + facts }
        ], 180);
        let answer = (spoken || "").trim();
        if (!answer || /backend_|SELECT /i.test(answer)) {
          answer = "Across the connected system I can see " + total.toLocaleString() + " orders in total. ";
          answer += bits.filter((b) => b.count).map((b) => b.label + " has " + b.count.toLocaleString()).join(", ") + ".";
        }
        const suggestions = ["What is the latest biowaste order?", "How many scrap orders?", "Bag prices"];
        
        return send(res, 200, { answer, sql: null, data: [], suggestions, steps: [{ label: "Counted every order group" }] });
      }


      if (/how many tables are there|number of tables|table count/i.test(q) && !/named|called|like/.test(q)) {
        const suggestions = ["How many tables named order", "Show waste bag prices"];
        const answer = await speak(q, "The connected database has " + cat.tables.length + " tables and " + (cat.relationships || []).length + " relationships.", [], suggestions);
        return send(res, 200, { answer, sql: null, data: [{ tables: cat.tables.length }], steps: [{ label: "Schema count only" }], suggestions });
      }
      if (/how many tables named|tables named|tables matching|tables like/i.test(q)) {
        const tks = tokens(q);
        const found = cat.tables.filter((t) => tks.some((tok) => t.name.toLowerCase().includes(tok)));
        const suggestions = found.slice(0, 6).map((t) => humanSuggest(orderKind(t.name)));
        const facts = found.length ? found.map((t, i) => (i + 1) + ". " + t.name).join("\n") : "No table name matched.";
        const answer = await speak(q, facts, found.map((t) => t.name), suggestions);
        return send(res, 200, { answer, sql: null, data: found.map((t) => ({ table: t.name })), steps: [{ label: "Listed every matching table name" }], suggestions });
      }

      const hits = matchAll(cat, q);
      steps.push({ label: hits.length ? ("Keyword matched " + hits.length + " table(s)") : "No keyword match" });
      if (!hits.length) {
        const suggestions = ["how many orders we got today", "how many orders we got Yesterday", "how many customers we have", "what is the latest order"];
        const answer = await speak(q, "I'm Restricted to respond only to questions about the Recollect C&D Information.", [], suggestions);
        return send(res, 200, { answer, sql: null, data: [], steps, suggestions });
      }

      const wantsLatest = /latest|last|recent|newest/.test(q);
      const orderHits = hits.filter((h) => /order/i.test(h.name));
      const workHits = (wantsLatest && orderHits.length) ? orderHits : hits;
      const names = workHits.map((h) => h.name);
      const suggestions = names.slice(0, 6).map((n) => (wantsLatest ? "Latest row in " : "Show ") + n);

      if (wantsLatest && workHits.length) {
        steps.push({ label: "Reading the newest row from each matching order table" });
        const db = await pool();
        const blocks = [];
        const sqls = [];
        try {
          for (const h of workHits.slice(0, 8)) {
            const d = dateCol(h.columns);
            const pc = pickCols(h.columns).map((n) => "`" + n + "`").join(", ");
            const sql = d ? ("SELECT " + pc + " FROM `" + h.name + "` ORDER BY `" + d + "` DESC LIMIT 1") : ("SELECT " + pc + " FROM `" + h.name + "` LIMIT 1");
            try {
              const [rows] = await db.query(sql);
              sqls.push(sql);
              if (rows && rows[0]) {
                const line = Object.entries(rows[0]).filter(([, v]) => v !== null && v !== "").map(([k, v]) => k.replace(/_/g, " ") + ": " + v).join("; ");
                blocks.push({ table: h.name, kind: orderKind(h.name), line, row: rows[0] });
              } else blocks.push({ table: h.name, line: "no rows", row: null });
            } catch (e) {
              blocks.push({ table: h.name, line: "could not read", row: null });
            }
          }
        } finally { await db.end(); }
        const facts = blocks.map((b) => (b.kind || orderKind(b.table)) + ": " + b.line).join("\n");
        const answer = await speak(q, facts, names, suggestions);
        const data = blocks.filter((b) => b.row).map((b) => Object.assign({ type: orderKind(b.table) }, b.row));
        mem.lastTables = names;
        mem.lastData = rowsForQuestion(q, data);
        return send(res, 200, { answer, sql: sqls.join(";\n"), data, tablesUsed: names, steps, suggestions });
      }

      if (false) { /* do not dump schema to the user */ }

      const best = workHits[0];
      const d = dateCol(best.columns);
      const pc = pickCols(best.columns).map((n) => "`" + n + "`").join(", ");
      let sql = "SELECT " + pc + " FROM `" + best.name + "` LIMIT 20";
      if (wantsLatest && d) sql = "SELECT " + pc + " FROM `" + best.name + "` ORDER BY `" + d + "` DESC LIMIT 1";
      const db = await pool();
      let rows = [];
      try { rows = (await db.query(sql))[0].slice(0, 30); } finally { await db.end(); }
      rows = rowsForQuestion(q, rows); const facts = (rows.length ? rows.map((r, i) => (i + 1) + ". " + Object.entries(r).filter(([, v]) => v !== null && v !== "").map(([k, v]) => k.replace(/_/g, " ") + ": " + v).join("; ")).join("\n") : "0 rows.") + (names.length > 1 ? ("\nOther matching tables: " + names.slice(1).join(", ")) : "");
      const answer = await speak(q, facts, names, suggestions);
      mem.lastTables = names;
      mem.lastData = rowsForQuestion(q, rows);
      return send(res, 200, { answer, sql, data: rowsForQuestion(q, typeof cleanRows !== "undefined" ? cleanRows : rows), tablesUsed: names, steps, suggestions });
    }
        if (req.method === "POST" && req.url && req.url.indexOf("/ask") === 0) {
      return send(res, 200, { answer: "I could not match that to the connected database. Ask about a person, vehicle, order, or table you know is in this system.", data: [], suggestions: (typeof liveSuggestions === "function" ? liveSuggestions("help") : []) });
    }
    return send(res, 404, { error: "Not Found" });
  } catch (err) {
    return send(res, 200, { answer: /Free chat|tokens/i.test(err.message) ? "Free chat requests completed." : err.message, data: [], suggestions: [] });
  }
});
const { spawn } = require("child_process");
spawn(process.execPath, [require("path").join(__dirname, "sync-lite.js")], { stdio: "inherit" });
server.listen(PORT, "0.0.0.0", () => console.log("Recollect AI Bot http://0.0.0.0:" + PORT));






































